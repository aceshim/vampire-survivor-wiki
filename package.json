{
  "name": "offline-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scrape namu.wiki game guides into an installable offline PWA",
  "scripts": {
    "scrape": "node scraper/scrape.mjs",
